FROM docker.m.daocloud.io/library/python:3.11-slim

WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONPATH=/app

COPY pyproject.toml .
RUN pip install --no-cache-dir --timeout 120 --retries 5 --no-build-isolation --index-url https://mirrors.aliyun.com/pypi/simple/ . \
    && pip install --no-cache-dir --timeout 120 --retries 5 --index-url https://mirrors.aliyun.com/pypi/simple/ pytest pytest-asyncio

COPY app ./app
COPY migrations ./migrations
COPY tests ./tests
COPY alembic.ini .

CMD ["pytest", "-q"]
