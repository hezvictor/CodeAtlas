{
  "name": "codeatlas-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "tsx --test \"src/**/*.test.ts\" \"src/**/*.test.tsx\"",
    "test:message": "tsx --test src/components/MessageContent.test.tsx",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc --noEmit --incremental false",
    "format": "prettier --write ."
  },
  "dependencies": {
    "highlight.js": "^11.11.1",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.25",
    "prettier": "^3.4.0",
    "tsx": "^4.23.13",
    "typescript": "^5.7.0"
  }
}
